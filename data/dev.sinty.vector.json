{
    "schema-id": "dev.sinty.vector",
    "settings": [
        { "key": "show-grid", "label": "Show Grid", "type": "boolean", "widget": "switch" },
        { "key": "snap-to-grid", "label": "Snap to Grid", "type": "boolean", "widget": "switch" },
        { "key": "snap-to-pixel", "label": "Snap to Pixel Grid", "type": "boolean", "widget": "switch" },
        { "key": "smart-guides", "label": "Smart Guides", "type": "boolean", "widget": "switch" },
        { "key": "snap-to-point", "label": "Snap to Points and Paths", "type": "boolean", "widget": "switch" },
        { "key": "show-rulers", "label": "Show Rulers", "type": "boolean", "widget": "switch" },
        { "key": "units", "label": "Units", "type": "string", "widget": "combo", "options": [ { "id": "px", "label": "Pixels" }, { "id": "pt", "label": "Points" }, { "id": "mm", "label": "Millimeters" }, { "id": "cm", "label": "Centimeters" }, { "id": "in", "label": "Inches" } ] },
        { "key": "artboard-preset", "label": "New Artboard Size", "type": "string", "widget": "combo", "options": [ { "id": "screen", "label": "Screen 1920 x 1080" }, { "id": "a4", "label": "A4" }, { "id": "letter", "label": "US Letter" }, { "id": "icon", "label": "Icon 256 x 256" }, { "id": "square", "label": "Square 1080 x 1080" } ] },
        { "key": "keyboard-increment", "label": "Arrow Key Distance", "type": "int", "widget": "spin", "min": 1, "max": 1000, "step": 1 },
        { "key": "scale-strokes", "label": "Scale Strokes and Effects", "type": "boolean", "widget": "switch" },
        { "key": "svg-decimals", "label": "SVG Decimal Places", "type": "int", "widget": "spin", "min": 0, "max": 8, "step": 1 },
        { "key": "history-limit", "label": "Undo Limit (0 is Unlimited)", "type": "int", "widget": "spin", "min": 0, "max": 100000, "step": 50 },
        { "key": "vectorizer-command", "label": "Local Vectorizer Command", "type": "string", "widget": "entry" }
    ]
}
